    "check": "npm run lint && npm run typecheck && npm run check:claims && npm run check:factors && npm test && npm run smoke && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.4.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
