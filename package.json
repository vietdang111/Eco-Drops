{
  "name": "eco-drops",
  "version": "1.0.0",
  "private": true,
  "description": "Verified surplus-to-campus reuse platform for Hackachusetts Climate Tech & Clean Energy.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
